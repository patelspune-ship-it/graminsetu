# Voice provider for the mic/listen buttons.
# "browser" (default): uses the browser's own Web Speech API
#   (webkitSpeechRecognition for ASR, speechSynthesis for TTS). Always
#   works, needs no backend key, but browser support/quality varies.
# "bhashini": calls /api/voice/transcribe and /api/voice/speak, which
#   need BHASHINI_API_KEY and BHASHINI_USER_ID set in backend/.env.
VITE_VOICE_PROVIDER=browser
